# Domínio público do site (capas de link e SEO). Na Vercel, sem isto, usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=

# Envio do formulário de visita (Resend). Sem estas variáveis, o pedido só é registrado no log do servidor.
RESEND_API_KEY=
CONTATO_EMAIL=contato@idearempreendimentos.com.br
CONTATO_REMETENTE="Site Idear <site@idearempreendimentos.com.br>"
